{
  "id": "oplus-generic",
  "name": "OPPO / OnePlus (generic OPlus)",
  "match": {},
  "notes": "Fallback used when no device-specific profile matches. Partition names follow the common OPlus layout; check the preview before backing up.",
  "backup": {
    "network": [
      { "name": "oplusstanvbk", "logical": false },
      { "name": "my_region", "logical": true }
    ],
    "critical": [
      { "name": "persist*", "logical": false },
      { "name": "modemst1", "logical": false },
      { "name": "modemst2", "logical": false },
      { "name": "fsg", "logical": false },
      { "name": "fsc", "logical": false },
      { "name": "ocdt", "logical": false },
      { "name": "devinfo", "logical": false },
      { "name": "oplusreserve*", "logical": false }
    ],
    "full_exclude": ["userdata", "metadata", "frp"]
  },
  "conditional": ["oplusstanvbk", "my_region", "odm"],
  "keep_apps": [
    "com.oplus.smartengine", "com.oplus.metis", "com.coloros.sceneservice", "com.coloros.phonemanager",
    "com.android.systemui.oplus.res.overlay", "com.oplus.systemui.plugins", "com.oplus.uiengine",
    "com.oplus.appplatform", "com.oplus.customize.coreapp", "com.oplus.securitypermission",
    "com.oplus.subsys", "com.oplus.wirelesssettings", "com.oplus.appdetail", "com.android.launcher",
    "com.oplus.launcher", "com.android.launcher3", "net.oneplus.launcher", "com.android.providers.*",
    "com.android.networkstack*", "com.google.android.networkstack*", "com.android.wifi*",
    "com.google.android.wifi*", "com.android.documentsui", "com.google.android.documentsui",
    "com.android.ext.services", "com.google.android.ext.services", "com.google.android.gms",
    "com.google.android.gsf", "com.android.vending", "com.oplus.athena", "com.coloros.athena",
    "com.oplus.battery", "com.coloros.securitypermission", "com.coloros.safecenter",
    "com.oplus.safecenter", "com.oplus.exsystemservice", "com.oplus.persist.system", "com.oplus.cosa",
    "com.oplus.framework*", "oplus", "*overlay*", "*_rro", "com.android.internal.*",
    "com.android.systemui.*", "com.android.phone.*", "android.*", "vendor.qti.*", "com.qualcomm.*",
    "com.qti.*", "org.codeaurora.*", "com.oplus.athena*", "com.oplus.trafficmonitor", "com.oplus.sos",
    "com.oplus.encryption", "com.android.mms.service", "com.android.cellbroadcastservice",
    "com.android.webview", "com.google.android.webview", "com.android.intentresolver",
    "com.android.photopicker", "com.android.storagemanager", "com.android.credentialmanager",
    "com.android.rkpdapp", "me.weishu.kernelsu", "com.rifsxd.ksunext", "com.sukisu.ultra",
    "me.bmax.apatch", "com.topjohnwu.magisk", "io.github.huskydg.magisk", "io.github.a13e300.ksuwebui",
    "com.dergoogler.mmrl", "com.dergoogler.mmrl.wx", "com.resukisu.resukisu", "me.tool.kernelsu",
    "com.termux"
  ],
  "avb_images": ["vbmeta", "vbmeta_system", "vbmeta_vendor"],
  "qcom_arb_images": ["xbl_config", "abl"],
  "qcom_arb_validated": false,
  "never_flash": [
    "persist*",
    "modemst1",
    "modemst2",
    "fsg",
    "fsc",
    "ocdt",
    "devinfo",
    "oplusreserve*",
    "userdata",
    "metadata",
    "frp"
  ]
